# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=your-mongodb-uri-here
# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRE=3d
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_REFRESH_EXPIRE=30d

# Redis Configuration (Optional)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (Brevo API)
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM_NAME=Job Event Up
EMAIL_FROM_ADDRESS=your-email@example.com

# File Upload Configuration
CLOUDINARY_API_KEY=your-cloudinary-api-key-here
CLOUDINARY_API_SECRET=your-cloudinary-api-secret-here
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name-here
MAX_FILE_SIZE=5242880

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
 
# Payment Gateway Configuration
VNPAY_TMN_CODE=your-vnpay-tmn-code-here
VNPAY_HASH_SECRET=your-vnpay-hash-secret-here
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
VNPAY_NOTIFY_URL=http://localhost:5000/api/payments/vnpay/notify

