PAYOS_CLIENT_ID=your-payos-client-id-here
PAYOS_API_KEY=your-payos-api-key-here
PAYOS_CHECKSUM_KEY=your_check_sum_key_here
PAYOS_RETURN_URL=http://localhost:5000/api/payments/payos/return
PAYOS_CANCEL_URL=http://localhost:5000/api/payments/payos/return

MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your-momo-access-key-here
MOMO_SECRET_KEY=your-momo-secret-key-here
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5000/api/payments/momo/return
MOMO_NOTIFY_URL=http://localhost:5000/api/payments/momo/notify

# CORS Configuration
CORS_ORIGIN=http://localhost:3000


# Subscription Configuration
PREMIUM_PRICE=10000
PREMIUM_DURATION_DAYS=30
FREE_POST_LIMIT=5
PREMIUM_POST_LIMIT=50
FREE_URGENT_LIMIT=0
PREMIUM_URGENT_LIMIT=10

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
